<Project Sdk="Microsoft.NET.Sdk">
  <!-- Daf for Windows (windows/README.md): WinUI 3 and WebView2 around the live site, with
       Daf's menus, today's minutes in the notification area and a copy for no connection.
       Unpackaged and self-contained: the folder dotnet publish makes runs as it is, and the
       installer only copies it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Daf</RootNamespace>
    <AssemblyName>Daf</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Daf</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Program.cs has Main: Daf runs once per person, and a second start hands its link to the first -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- windows/tools/make-icon.ps1 makes it from design/icon/final -->
  <PropertyGroup Condition="Exists('Assets\Daf.ico')">
    <ApplicationIcon>Assets\Daf.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daf.Core\Daf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Daf.ico" Condition="Exists('Assets\Daf.ico')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
