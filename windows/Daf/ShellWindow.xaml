<?xml version="1.0" encoding="utf-8"?>
<!-- One Daf window: a title bar in the page's own colour, with Daf's menus in it (Menus.cs),
     over the page, which ShellWindow.xaml.cs adds once WebView2 is ready. -->
<Window
    x:Class="Daf.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="Strip" Grid.Row="0" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <Image x:Name="AppIcon" Grid.Column="0" Width="16" Height="16" Margin="12,0,4,0" VerticalAlignment="Center" />
            <MenuBar x:Name="Menu" Grid.Column="1" Height="32" VerticalAlignment="Center" />
            <Grid x:Name="DragArea" Grid.Column="2" Background="Transparent" />
        </Grid>
    </Grid>
</Window>
