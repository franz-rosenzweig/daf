<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only where it's safe: Daf on the tailnet (WireGuard carries it encrypted) and
     localhost (the test build's sandbox, through adb reverse). Everything else, https only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">100.91.202.11</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
