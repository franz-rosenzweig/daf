<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- a job that waits for a connection (the nudge's check) needs it from Android 16 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the evening nudge: a notification, and which app is in front (Usage Access, granted by hand) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- listening with the screen off: a media-playback service, awake while it plays -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the nudge's check survives a restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".Daf"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Daf"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <!-- The app: the live site in a WebView. The widget, the shortcuts and the
             nudge open it on a page of Daf (the intent's data is a #route). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share into Daf: a link goes to the Library, a photo of a marked page
             becomes a paper page. No window of its own. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Save to Daf"
            android:theme="@style/Theme.Daf.Share"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="Daf settings"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".Widget"
            android:exported="true"
            android:label="Daf: today's hour">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>

        <!-- the evening nudge's check, every 15 minutes while it's on -->
        <!-- new posts from the feeds set to notify, every 15 minutes (FeedNews) -->
        <service
            android:name=".FeedNews"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- books on the phone, brought up to date every few hours (Offline) -->
        <service
            android:name=".Offline"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".NudgeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- read-aloud on the lock screen and the headphones' buttons -->
        <service
            android:name=".Listen"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- files handed to the share sheet (Share as image), from the app's cache -->
        <provider
            android:name=".ShareProvider"
            android:authorities="${shareAuthority}"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
